{
	"chat.disableAIFeatures": true,
	"editor.accessibilitySupport": "off",
	"editor.colorDecoratorsActivatedOn": "click",
	"editor.cursorBlinking": "solid",
	"editor.cursorHeight": 20,
	"editor.cursorStyle": "line",
	"editor.fontFamily": "JetBrains Mono",
	"editor.fontLigatures": "'calt', 'liga', 'ss01', 'ss19', 'cv18', 'zero'",
	"editor.fontSize": 12,
	"editor.fontVariations": "'wght' 500",
	"editor.fontWeight": 400,
	"editor.guides.bracketPairs": "active",
	"editor.guides.highlightActiveBracketPair": true,
	"editor.guides.highlightActiveIndentation": false,
	"editor.guides.indentation": true,
	"editor.letterSpacing": -0.048,
	"editor.lineHeight": 1.2,
	"editor.matchBrackets": "never",
	"editor.minimap.enabled": false,
	"editor.renderLineHighlight": "all",
	"editor.rulers": [
		{
			"color": "#333",
			"column": 120
		}
	],
	"editor.scrollbar.verticalScrollbarSize": 8,
	"editor.tabSize": 2,
	"explorer.autoReveal": false,
	"javascript.preferences.importModuleSpecifier": "project-relative",
	"javascript.preferences.useAliasesForRenames": false,
	"javascript.updateImportsOnFileMove.enabled": "always",
	"terminal.integrated.cursorStyle": "line",
	"terminal.integrated.cursorStyleInactive": "line",
	"terminal.integrated.fontFamily": "JetBrains Mono NL",
	"terminal.integrated.letterSpacing": 0,
	"terminal.integrated.lineHeight": 1,
	"typescript.preferences.importModuleSpecifier": "project-relative",
	"typescript.preferences.useAliasesForRenames": false,
	"typescript.tsserver.maxTsServerMemory": 8192,
	"typescript.tsserver.nodePath": "/Users/weihuaz/.local/share/fnm/aliases/lts-jod/bin/node",
	"typescript.tsserver.useSyntaxServer": "auto",
	"typescript.updateImportsOnFileMove.enabled": "always",
	"vscode_custom_css.statusbar": false,
	"window.autoDetectColorScheme": true,
	"workbench.activityBar.location": "top",
	"workbench.editor.customLabels.enabled": true,
