{
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_size": 12,
  "buffer_font_weight": 500.0,
  "buffer_line_height": {
    "custom": 1.2
  },
  "code_actions_on_format": {
    "source.fixAll.eslint": true
  },
  "current_line_highlight": "all",
  "cursor_blink": false,
  "cursor_shape": "bar",
  "diagnostics": {
    "inline": {
      "enabled": true,
      "update_debounce_ms": 400
    }
  },
  "expand_excerpt_lines": 5,
  "formatter": "language_server",
  "gutter": {
    "min_line_number_digits": 2
  },
  "icon_theme": "VSCode Icons for Zed (Dark)",
  "inlay_hints": {
    "enabled": false
  },
  "languages": {
    "CSS": {
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      }
    },
    "JavaScript": {
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      }
    },
    "JSON": {
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      }
    },
    "JSONC": {
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      }
    },
    "TSX": {
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      }
    },
    "TypeScript": {
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      }
    }
  },
  "lsp": {
    "biome": {
      "settings": {
        "require_config_file": true
      }
    },
    "vtsls": {
      "settings": {
        "javascript": {
          "tsserver": {
            "maxTsServerMemory": 8192
          }
        },
        "typescript": {
          "tsserver": {
            "maxTsServerMemory": 8192
          }
        }
      }
    }
  },
  "lsp_highlight_debounce": 400,
  "minimap": {
    "show": "never"
  },
  "node": {
    "path": "/Users/weihuaz/.local/share/fnm/aliases/lts-jod/bin/node"
  },
  "preview_tabs": {
    "enable_preview_from_project_panel": false,
    "enabled": false
  },
  "project_panel": {
    "auto_reveal_entries": false,
    "indent_guides": {
      "show": "never"
    }
  },
  "rounded_selection": true,
  "sticky_scroll": {
    "enabled": true
  },
  "tab_bar": {
    "show": true,
    "show_tab_bar_buttons": true
  },
  "tabs": {
    "close_position": "right",
    "file_icons": true,
    "git_status": true
  },
  "terminal": {
    "cursor_shape": "bar",
    "font_family": "JetBrains Mono NL",
    "font_size": 12.0,
    "font_weight": 500.0,
    "toolbar": {
      "breadcrumbs": false
    }
  },
  "text_rendering_mode": "grayscale",
  "theme": {
    "dark": "Min Dark (Blurred)",
    "light": "Ayu Light",
    "mode": "dark"
  },
  "title_bar": {
    "show_branch_icon": false,
    "show_branch_name": true,
    "show_menus": false,
    "show_sign_in": false
  },
  "toolbar": {
    "agent_review": false
  },
  "ui_font_family": "Lucida Grande",
  "ui_font_size": 14
}
